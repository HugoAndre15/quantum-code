# ─── Base de données ─────────────────────────────────────────────────────────
# URL de connexion PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quantum_code"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change_me_jwt_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Admin par défaut (utilisé par prisma/seed.ts) ───────────────────────────
ADMIN_EMAIL="admin@quantumcode.dev"
ADMIN_PASSWORD="VotreMotDePasseSecurise!"
ADMIN_NAME="Admin Quantum Code"

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=3001

# URL du frontend autorisée par la politique CORS (séparées par des virgules si plusieurs)
# ⚠️  En production (Railway), cette variable DOIT correspondre à l'URL réelle du frontend.
# Exemple production: FRONTEND_URL="https://quantum-code-theta.vercel.app"
# Plusieurs origines: FRONTEND_URL="https://quantum-code-theta.vercel.app,http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# ─── Emails transactionnels (Brevo API v3) ───────────────────────────────────
BREVO_API_KEY="your_brevo_api_v3_key"
MAIL_FROM="contact@quantum-code.fr"
MAIL_FROM_NAME="Quantum Code"
# Destinataire des notifications internes (leads, contacts, devis acceptés).
# Si omis, MAIL_FROM est utilisé.
MAIL_ADMIN_TO="contact@quantum-code.fr"

# ─── Paiements Stripe Checkout ───────────────────────────────────────────────
# Utiliser les clés test_ pour valider le parcours avant de passer en production.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
